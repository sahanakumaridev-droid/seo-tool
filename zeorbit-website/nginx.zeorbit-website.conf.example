# Nginx site — ZeOrbit website sibling of SEO Tool
# Install: copy to /etc/nginx/sites-available/zeorbit-website and symlink into sites-enabled.

server {
    listen 80;
    server_name zeorbit.159.198.79.219.nip.io;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2; # keep http2 — PSI mobile loses ~750ms on HTTP/1.1
    server_name zeorbit.159.198.79.219.nip.io;
    root /var/www/zeorbit-website;
    index index.html;
    error_page 404 /404.html;

    include /etc/nginx/snippets/zeorbit-geo-rewrite.conf;
    include /etc/nginx/snippets/zeorbit-security.conf;
    include /etc/nginx/snippets/zeorbit-geo-us.conf;

    # HTML entry — always revalidate
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        try_files $uri =404;
    }

    # Hashed Vite bundles — immutable
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Hero video + section films — cache 30 days (browser will reuse)
    location /videos/ {
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        add_header Accept-Ranges bytes always;
        try_files $uri =404;
    }

    # Showcase imagery — cache 30 days
    location /showcase/ {
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        try_files $uri =404;
    }

    # Logo + other public static images
    location ~* \.(png|jpe?g|gif|webp|svg|ico|woff2?)$ {
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Live sitemaps from SEO tool (published blogs), not the empty static files
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:8001/sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }
    location = /page-sitemap.xml {
        proxy_pass http://127.0.0.1:8001/page-sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }
    location = /post-sitemap.xml {
        proxy_pass http://127.0.0.1:8001/post-sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    # Old /p/{slug} article URLs → /{slug}
    location ^~ /p/ {
        rewrite ^/p/(.*)$ /$1 permanent;
    }

    # SEO articles at /web-design-san-diego (keyword + city). SPA routes stay on Vite.
    # Missing/removed tool pages must return real 404 so Google drops test URLs.
    location ~ "^/(?!(?:blog|contact|portfolio|mobile-apps|custom-software|seo-ppc|website-designing|web-designer-near-me|areas|revamp-preview|us-only|health|api|assets|videos|showcase|p)(?:/|$))([a-z0-9][a-z0-9-]{2,})/?$" {
        proxy_pass http://127.0.0.1:8001/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    }

    location = /health {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    include /etc/nginx/snippets/zeorbit-redirects.conf;

    location = /404.html {
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, follow" always;
    }

    # Marketing routes must boot the SPA even when public/{route}/index.html
    # exists as a crawler stub. Without this, /blog/ never loads React.
    location ~ ^/(blog|contact|portfolio|mobile-apps|custom-software|seo-ppc|website-designing|web-designer-near-me|privacy-policy|areas)(/.*)?$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        try_files /index.html =404;
    }

    # Unique static HTML in public/{route}/index.html. Unknown URLs must 404
    # (never the homepage shell).
    location / {
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        try_files $uri $uri/ =404;
    }
}
