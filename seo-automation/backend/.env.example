# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seo_automation

# ── AI Content Generation ────────────────────────────────────────
# Pick ONE free LLM below (recommended). If none set, a free template engine is used.
# Groq (free, fast): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Which provider to prefer: auto | groq | gemini | openai
LLM_PROVIDER=auto

# OpenAI (paid, optional — used only if the free options above are empty)
OPENAI_API_KEY=
# Optional additional AI providers (used by advanced/streaming/semantic services)
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# ── Location APIs ────────────────────────────────────────────────
OPENCAGE_API_KEY=
GEODB_API_KEY=
GOOGLE_PLACES_API_KEY=
# Used by prospecting AND the public ZeOrbit site reviews feed (/api/google-reviews).
# Enable Places API (New) on the same Google Cloud project.

# ── WordPress ────────────────────────────────────────────────────
WP_URL=https://yoursite.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_SEO_PLUGIN=rankmath   # rankmath | aioseo | yoast

# ── Google Search automation (free, official APIs only) ──────────
# Service-account key shared with GOOGLE_INDEXING_KEY_FILE below — just
# needs the Search Console API enabled in the same Google Cloud project.
# Run: python3 scripts/setup_gsc.py
PUBLIC_BASE_URL=https://zeorbit.com
MARKETING_SITE_URL=https://zeorbit.com
GSC_SITE_URL=https://zeorbit.com/
WP_SITEMAP_URL=https://zeorbit.com/sitemap.xml
GOOGLE_INDEXING_KEY_FILE=./secrets/gsc-service-account.json
GSC_VERIFICATION_META=
GSC_VERIFICATION_FILENAME=
GSC_VERIFICATION_FILE_BODY=
GSC_AUTO_PUSH_ON_PUBLISH=true

# ── Image APIs (pick one or both) ───────────────────────────────
# Unsplash: https://unsplash.com/developers (free, 50 req/hr)
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/ (free, 200 req/hr)
PEXELS_API_KEY=

# ── Social Media ─────────────────────────────────────────────────
# Facebook: https://developers.facebook.com/
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Twitter/X: https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LinkedIn: https://www.linkedin.com/developers/
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:XXXXXXXX

# Instagram (via Facebook Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Pinterest: https://developers.pinterest.com/ (requires app review to post)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Threads (via Meta Threads API): https://developers.facebook.com/docs/threads
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Google Business Profile: https://developers.google.com/my-business
# GBP_REFRESH_TOKEN (recommended) is exchanged for a fresh access token on
# every post using the GOOGLE_ADS_CLIENT_ID/SECRET OAuth client below (same
# Google Cloud project, just needs the business.manage scope consented too).
# GBP_ACCESS_TOKEN alone works but expires in ~1hr and won't self-renew.
GBP_ACCESS_TOKEN=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Google Ads (campaign creation): https://developers.google.com/google-ads/api/docs/first-call/overview
# Requires `pip install google-ads` (optional dep, not in the default requirements.txt).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# true = publishing a /p/ page also creates a Search campaign (paused unless AUTO_ENABLE)
GOOGLE_ADS_AUTO_CREATE_ON_PUBLISH=true
# true = create campaigns ENABLED (can spend). Keep false unless billing is intentional.
GOOGLE_ADS_AUTO_ENABLE=false

# ── Production vs demo ───────────────────────────────────────────
# false = production (free crawl + free Groq/Gemini + live Google APIs when set)
# true  = sales demo simulation ONLY when live Google credentials are missing
DEMO_MODE=false

# ── Lead Capture & Prospecting ───────────────────────────────────
# Prospecting uses GOOGLE_PLACES_API_KEY (set above under Location APIs)

# Website contact form → email inbox (Namecheap Private Email)
LEAD_NOTIFY_TO=info@zeorbit.com
SMTP_FROM=info@zeorbit.com
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=info@zeorbit.com
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ── Marketing / Tracking (published /p/ pages) ──────────────────
# Google Tag Manager container id — leave empty to ship pages without it.
GTM_CONTAINER_ID=
# Google AdSense — leave empty to ship pages without ads.
# Client id looks like "ca-pub-1234567890123456" (AdSense > Sites > Get code).
ADSENSE_CLIENT_ID=
# Optional: a specific ad unit slot id for the in-article placement.
# If empty, only the auto-ads script loads (no manual in-article unit).
ADSENSE_SLOT_ID=

# ── Frontend ─────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app
# Public base for /p/{slug} SEO pages used as Google Ads final URLs.
# Must be a real public domain (not localhost). Example:
# PUBLIC_BASE_URL=https://seo.yourdomain.com
PUBLIC_BASE_URL=
